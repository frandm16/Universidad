# Definici?n de una funci?n en R y su asignaci?n a una variable para poder usarla
ff <- function(x, y){
x + 2 * y
}
# Lo podemos llamar con n?meros o con vectores
ff(2,3)
ff(1:5, 11:15)
# Definici?n de funci?n con valor por defecto en uno de sus argumentos
ff2 <- function(x, y=10){
x + 2 * y
}
ff2(2,3)
ff2(2)
# Diversas formas de llamar a la funci?n
ff(2, 100)
ff(100, 2)
ff(x=2, y=100)
ff(y=100, x=2)
ff(y=100, 2)
# sum admite un n?mero indefinido de argumentos y se puede utilizar con un vector o con m?ltiples argumentos
sum(1, 3, 4, 23)
sum(c(1, 3, 4, 23))
# Pero ojo, mean no funciona igual. Hay que llamarlo con un vector
mean(1, 3, 4, 23)
mean(c(1, 3, 4, 23))
# Creaci?n de un data frame y visualizaci?n
df <- data.frame(x=c(1,2,3), y=c("a", "xx", "jo"))
df
View(df)
